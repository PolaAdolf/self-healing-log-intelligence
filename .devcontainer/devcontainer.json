{
  "name": "Self-Healing Log Intelligence",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Log Observatory",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  }
}
